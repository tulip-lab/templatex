{
  "name": "slidev-theme-tulip-lab",
  "version": "0.3.0",
  "description": "TULIP Lab theme for 16:10 Slidev courses and talks, including acknowledgements.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tulip-lab/templatex.git",
    "directory": "slidev/packages/slidev-theme-tulip-lab"
  },
  "bugs": {
    "url": "https://github.com/tulip-lab/templatex/issues"
  },
  "homepage": "https://github.com/tulip-lab/templatex/tree/main/slidev/packages/slidev-theme-tulip-lab",
  "files": [
    "assets",
    "components",
    "docs",
    "composables",
    "layouts",
    "styles",
    "utils",
    "global-bottom.vue",
    "global-top.vue",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "qrcode.vue": "3.10.0"
  },
  "devDependencies": {
    "tsx": "4.23.12"
  },
  "engines": {
    "node": ">=20",
    "slidev": ">=52.0.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "16/10",
      "canvasWidth": 1280,
      "transition": "fade-out",
      "layout": "default"
    }
  },
  "keywords": [
    "slidev",
    "slidev-theme",
    "theme",
    "tulip-lab"
  ]
}
